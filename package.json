{
  "name": "alphorn",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "description": "Self-hostable notification router. Receive webhooks, route messages to 24+ channels with filtering rules.",
  "repository": {
    "type": "git",
    "url": "https://github.com/alphorn-dev/alphorn.git"
  },
  "homepage": "https://alphorn.dev/",
  "bugs": {
    "url": "https://github.com/alphorn-dev/alphorn/issues"
  },
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "db:seed": "prisma db seed",
    "build:worker": "esbuild src/worker/standalone.ts --bundle --platform=node --format=esm --outfile=worker.mjs --alias:@=./src --packages=external --banner:js='import{createRequire}from\"module\";const require=createRequire(import.meta.url);'",
    "dev:worker": "npx tsx src/worker/standalone.ts",
    "sse-server": "npx tsx src/sse-server/index.ts",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:integration-db": "vitest run --project integration-db",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@paddle/paddle-node-sdk": "^3.10.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@sentry/nextjs": "^11.6.0",
    "@sentry/node": "^11.6.0",
    "better-auth": "~1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.55.0",
    "nanoid": "^6.0.2",
    "next": "16.4.0",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.1.0",
    "pg": "^8.23.1",
    "pg-boss": "^12.37.1",
    "pino": "^10.4.0",
    "prisma": "^7.10.0",
    "qrcode.react": "^4.2.0",
    "react": "19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "remark-breaks": "^4.0.0",
    "safe-regex2": "^5.1.2",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "undici": "^8.11.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.3",
    "dotenv": "^18.0.7",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.0",
    "pino-pretty": "^13.2.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
